#!/bin/sh
exec 2>&1
set -e

envdir="${XDG_RUNTIME_DIR}/runit/env"
sock="${XDG_RUNTIME_DIR}/ssh-agent.sock"

if [ ! -d "$envdir" ]; then
    echo "ssh-agent: ${envdir} not found, per-user runit environment not initialized (e.g. userspawn-runit)" >&2
    exit 1
fi

echo "$sock" > "$envdir/SSH_AUTH_SOCK"
exec ssh-agent -D -a "$sock"
