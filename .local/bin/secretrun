#!/bin/bash

# secretrun: run a command with secrets that you type into dmenu.
#
# The secret goes into the command (stdin, env var, tmpfs file or a later
# askpass prompt) and is never printed back. Only the command's own output
# is shown, with the typed values redacted.
#
# usage: secretrun [options] -- command [args...]
#   --env NAME[=LABEL]   prompt now, export the secret as $NAME
#   --file NAME[=LABEL]  prompt now, write it to a 0600 tmpfs file, export the
#                        file's path as $NAME (file removed when command exits)
#   --stdin[=LABEL]      prompt now, feed it as a line on the command's stdin
#                        (repeatable, in order; the real stdin follows)
#   --no-askpass         do not expose SSH_ASKPASS/SUDO_ASKPASS/GIT_ASKPASS
#   --redact/--no-redact force redaction on/off (default: on unless stdout is
#                        a terminal, so interactive use keeps its tty)
#
# Prompts are asked in command-line order, each one showing the label and the
# full command. Escape in dmenu aborts and nothing runs.
#
# Nesting: secretrun can wrap itself (secretrun ... -- secretrun ... -- cmd).
# Tools run underneath (ssh, sudo -A, git, ...) can also ask mid-run through the
# askpass helper; every mid-run prompt shows the chain of wrapped commands.
#
# example:
#   secretrun --stdin=login --stdin=sudo -- sshpass-less-ssh-wrapper host
#   secretrun --env PGPASSWORD=db -- psql -h db.local -U app

# Askpass helper mode: invoked by tools via the generated wrapper below.
if [ "$1" = "--ask" ]; then
    shift
    prompt="${1:-password:} | via: ${SECRETRUN_CHAIN:-?}"
    pw=$(dmenu -fn Monospace-18 -P -p "$prompt " <&-) || exit 1
    [ -n "$SECRETRUN_DIR" ] && printf '%s\n' "$pw" >>"$SECRETRUN_DIR/secrets"
    printf '%s\n' "$pw"
    exit 0
fi

self=$(readlink -f -- "$0")
askpass=1
redact=auto
specs=() # kind:name:label, in order

while [ $# -gt 0 ]; do
    case "$1" in
        --env | --file)
            [ -n "$2" ] || { echo "secretrun: $1 needs NAME[=LABEL]" >&2; exit 2; }
            kind=${1#--}; spec=$2; shift 2
            name=${spec%%=*}; label=${spec#*=}; [ "$label" = "$spec" ] && label=$name
            case "$name" in
                [A-Za-z_]*) ;;
                *) echo "secretrun: bad variable name: $name" >&2; exit 2 ;;
            esac
            case "$name" in
                *[!A-Za-z0-9_]*) echo "secretrun: bad variable name: $name" >&2; exit 2 ;;
            esac
            specs+=("$kind:$name:$label") ;;
        --stdin) specs+=("stdin::stdin secret"); shift ;;
        --stdin=*) specs+=("stdin::${1#--stdin=}"); shift ;;
        --no-askpass) askpass=0; shift ;;
        --redact) redact=1; shift ;;
        --no-redact) redact=0; shift ;;
        -h | --help) sed -n '3,30p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        --) shift; break ;;
        *) echo "secretrun: unknown option: $1 (use -- before the command)" >&2; exit 2 ;;
    esac
done
[ $# -gt 0 ] || { echo "secretrun: no command given" >&2; exit 2; }

[ "$redact" = auto ] && { [ -t 1 ] && redact=0 || redact=1; }

cmdstr=$(printf '%s ' "$@" | tr '\n' ' ')
cmdstr=${cmdstr% }
export SECRETRUN_CHAIN="${SECRETRUN_CHAIN:+$SECRETRUN_CHAIN > }$cmdstr"

umask 077
tmp=$(mktemp -d "${XDG_RUNTIME_DIR:-/tmp}/secretrun.XXXXXX") || exit 1
trap 'rm -rf -- "$tmp"' EXIT
: >"$tmp/secrets"

stdin_secrets=()
n=0
for spec in "${specs[@]}"; do
    kind=${spec%%:*}; rest=${spec#*:}; name=${rest%%:*}; label=${rest#*:}
    pw=$(dmenu -fn Monospace-18 -P -p "$label | $cmdstr: " <&-) || exit 1
    printf '%s\n' "$pw" >>"$tmp/secrets"
    case "$kind" in
        env) export "$name=$pw" ;;
        file)
            n=$((n + 1))
            printf '%s' "$pw" >"$tmp/file.$n"
            export "$name=$tmp/file.$n" ;;
        stdin) stdin_secrets+=("$pw") ;;
    esac
done
unset pw

if [ "$askpass" = 1 ]; then
    printf '#!/bin/sh\nSECRETRUN_DIR=%q exec %q --ask "$@"\n' "$tmp" "$self" >"$tmp/askpass"
    chmod 700 "$tmp/askpass"
    export SSH_ASKPASS="$tmp/askpass" SSH_ASKPASS_REQUIRE=force
    export SUDO_ASKPASS="$tmp/askpass" GIT_ASKPASS="$tmp/askpass"
fi

redactor() {
    awk -v f="$tmp/secrets" '{
        line = $0
        while ((getline s < f) > 0) {
            if (s == "") continue
            out = ""
            while ((i = index(line, s)) > 0) {
                out = out substr(line, 1, i - 1) "***"
                line = substr(line, i + length(s))
            }
            line = out line
        }
        close(f)
        print line
        fflush()
    }'
}

run() {
    if [ ${#stdin_secrets[@]} -gt 0 ]; then
        { printf '%s\n' "${stdin_secrets[@]}"; cat; } | "$@"
    else
        "$@"
    fi
}

if [ "$redact" = 1 ]; then
    mkfifo "$tmp/out" "$tmp/err"
    redactor <"$tmp/out" & p1=$!
    redactor <"$tmp/err" >&2 & p2=$!
    run "$@" >"$tmp/out" 2>"$tmp/err"
    rc=$?
    wait "$p1" "$p2"
    exit "$rc"
else
    run "$@"
    exit $?
fi
