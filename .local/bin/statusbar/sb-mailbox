#!/bin/sh

# Displays number of unread mail and an loading icon if updating.
# When clicked, brings up `neomutt`.

case $BLOCK_BUTTON in
	1) maildir="${XDG_DATA_HOME:-$HOME/.local/share}/mail"
	   msg=""
	   for account in "$maildir"/*/; do
	       name="${account%/}"
	       name="${name##*/}"
	       count="$(find "$account"[Ii][Nn][Bb][Oo][Xx]/new/ -type f 2>/dev/null | wc -l)"
	       [ "$count" -gt 0 ] && msg="${msg}${name}: ${count}\n"
	   done
	   [ -z "$msg" ] && msg="No unread mail"
	   notify-send "📬 Unread mail" "$(printf '%b' "$msg")" ;;
	2) setsid -f mw -Y >/dev/null ;;
	3) notify-send "📬 Mail module" "\- Shows unread mail
- Shows 🔃 if syncing mail
- Left click shows unread per account
- Middle click syncs mail" ;;
	6) setsid -f "$TERMINAL" -e "$EDITOR" "$0" ;;
esac

unread="$(find "${XDG_DATA_HOME:-$HOME/.local/share}"/mail/*/[Ii][Nn][Bb][Oo][Xx]/new/* -type f | wc -l 2>/dev/null)"

pidof mbsync >/dev/null 2>&1 && icon="🔃"

[ "$unread" = "0" ] && [ "$icon" = "" ] || echo "📬$unread$icon"
