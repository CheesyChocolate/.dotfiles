#!/usr/bin/env bash

# This is bound to Shift+PrintScreen by default, requires maim. It lets you
# choose the kind of screenshot to take, including copying the image or even
# highlighting an area to copy. scrotcucks on suicidewatch right now.

# variables
output="$(date '+%y%m%d-%H%M-%S').png"

if [[ -n "$WAYLAND_DISPLAY" ]]; then
	menu="bemenu"
	copy_cmd="wl-copy"
	ocr_copy_cmd="wl-copy"
else
	menu="dmenu"
	copy_cmd="xclip -sel clip -t image/png"
	ocr_copy_cmd="xclip -sel clip"
fi

choice=$(printf "a selected area\\ncurrent window\\nfull screen\\na selected area (copy)\\ncurrent window (copy)\\nfull screen (copy)\\na selected area (OCR)\\nread QR code (copy)" | $menu -l 8 -i -p "Screenshot which area?")

if [[ -n "$WAYLAND_DISPLAY" ]]; then
	case "$choice" in
	"a selected area")
		grim -g "$(slurp)" "pic-selected-${output}"
		;;
	"current window")
		active_window_geom=$(hyprctl activewindow -j | jq -r '"\(.at[0]),\(.at[1]) \(.size[0])x\(.size[1])"')
		grim -g "$active_window_geom" "pic-window-${output}"
		;;
	"full screen")
		grim "pic-full-${output}"
		;;
	"a selected area (copy)")
		grim -g "$(slurp)" - | $copy_cmd
		;;
	"current window (copy)")
		active_window_geom=$(hyprctl activewindow -j | jq -r '"\(.at[0]),\(.at[1]) \(.size[0])x\(.size[1])"')
		grim -g "$active_window_geom" - | $copy_cmd
		;;
	"full screen (copy)")
		grim - | $copy_cmd
		;;
	"a selected area (OCR)")
		tmpfile=$(mktemp /tmp/ocr-XXXXXX.png)
		grim -g "$(slurp)" "$tmpfile"
		if [[ -s "$tmpfile" ]]; then
			tesseract "$tmpfile" - -l eng | $ocr_copy_cmd
		fi
		rm "$tmpfile"
		;;
	"read QR code (copy)")
		tmpfile=$(mktemp /tmp/ocr-XXXXXX.png)
		grim -g "$(slurp)" "$tmpfile"
		if [[ -s "$tmpfile" ]]; then
			zbarimg "$tmpfile" | $ocr_copy_cmd
		fi
		rm "$tmpfile"
		;;
	esac
else
	case "$choice" in
	"a selected area") maim -u -s pic-selected-"${output}" ;;
	"current window") maim -B -q -d 0.2 -i "$(xdotool getactivewindow)" pic-window-"${output}" ;;
	"full screen") maim -q -d 0.2 pic-full-"${output}" ;;
	"a selected area (copy)") maim -u -s | ${xclip_cmd} ;;
	"current window (copy)") maim -q -d 0.2 -i "$(xdotool getactivewindow)" | ${xclip_cmd} ;;
	"full screen (copy)") maim -q -d 0.2 | ${xclip_cmd} ;;
	"a selected area (OCR)") tmpfile=$(mktemp /tmp/ocr-XXXXXX.png) && maim -u -s >"$tmpfile" && tesseract "$tmpfile" - -l eng | ${ocr_cmd} && rm "$tmpfile" ;;
	"read QR code (copy)") tmpfile=$(mktemp /tmp/ocr-XXXXXX.png) && maim -u -s >"$tmpfile" && zbarimg "$tmpfile" | ${ocr_cmd} && rm "$tmpfile" ;;
	esac
fi
