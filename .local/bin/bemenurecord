#!/bin/sh

# Usage:
# `$0`: Ask for recording type via bemenu
# `$0 screencast`: Record both audio and screen
# `$0 video`: Record only screen
# `$0 audio`: Record only audio
# `$0 kill`: Kill existing recording
#
# If there is already a running instance, user will be prompted to end it.

updateicon() {
	echo "$1" > /tmp/recordingicon
	pkill -RTMIN+9 "${STATUSBAR:-dwmblocks}"
}

killrecording() {
	recpid="$(cat /tmp/recordingpid)"
	# ffmpeg ignores SIGINT when started as a background process; use SIGTERM instead
	if [ "$(cat /tmp/recordingtype 2>/dev/null)" = "ffmpeg" ]; then
		kill -TERM "$recpid"
	else
		kill -INT "$recpid"
	fi
	rm -f /tmp/recordingpid /tmp/recordingtype
	updateicon ""
	exit
}

screencast() {
	gpu-screen-recorder -w screen -f 60 -a default_output -o "$HOME/screencast-$(date '+%y%m%d-%H%M-%S').mp4" &
	echo $! > /tmp/recordingpid
	updateicon "⏺️🎙️"
}

video() {
	gpu-screen-recorder -w screen -f 60 -a default_output -o "$HOME/video-$(date '+%y%m%d-%H%M-%S').mp4" &
	echo $! > /tmp/recordingpid
	updateicon "⏺️"
}

videoselected() {
	if [ "$XDG_SESSION_TYPE" = "wayland" ]; then
		region=$(slurp -f "%wx%h+%x+%y") || return
	else
		region=$(slop -f "%wx%h+%x+%y") || return
	fi
	gpu-screen-recorder -w region -region "$region" -f 60 -a default_output -o "$HOME/box-$(date '+%y%m%d-%H%M-%S').mp4" &
	echo $! > /tmp/recordingpid
	updateicon "⏺️"
}

webcamhidef() {
	gpu-screen-recorder -w /dev/video0 -f 60 -o "$HOME/webcam-$(date '+%y%m%d-%H%M-%S').mp4" &
	echo $! > /tmp/recordingpid
	updateicon "🎥"
}

webcam() {
	gpu-screen-recorder -w "/dev/video0;camera_width=640;camera_height=480" -f 60 -o "$HOME/webcam-$(date '+%y%m%d-%H%M-%S').mp4" &
	echo $! > /tmp/recordingpid
	updateicon "🎥"
}

audio() {
	ffmpeg -f pulse -i "$(pactl get-default-sink).monitor" -c:a flac "$HOME/audio-$(date '+%y%m%d-%H%M-%S').flac" &
	echo $! > /tmp/recordingpid
	echo "ffmpeg" > /tmp/recordingtype
	updateicon "🎙️"
}

askrecording() {
	choice=$(printf "screencast\nvideo\nvideo selected\naudio\nwebcam\nwebcam (hi-def)" | bemenu -i -p "Select recording style:")
	case "$choice" in
		screencast) screencast;;
		audio) audio;;
		video) video;;
		*selected) videoselected;;
		webcam) webcam;;
		"webcam (hi-def)") webcamhidef;;
	esac
}

asktoend() {
	response=$(printf "No\nYes" | bemenu -i -p "Recording still active. End recording?") &&
	[ "$response" = "Yes" ] && killrecording
}

case "$1" in
	screencast) screencast;;
	audio) audio;;
	video) video;;
	*selected) videoselected;;
	kill) killrecording;;
	*) ([ -f /tmp/recordingpid ] && asktoend && exit) || askrecording;;
esac
